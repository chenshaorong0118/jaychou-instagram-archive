{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenshaorong0118/jaychou-instagram-archive/schema/item.schema.json",
  "title": "Jay Chou Instagram public archive item v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pk",
    "item_type",
    "published_at_utc",
    "published_at_taipei",
    "caption",
    "text",
    "shared_post",
    "music",
    "has_image",
    "has_video",
    "has_audio",
    "media"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "pk": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "item_type": { "enum": ["post", "story"] },
    "published_at_utc": { "type": "string", "format": "date-time" },
    "published_at_taipei": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+08:00$"
    },
    "caption": { "type": ["string", "null"] },
    "text": { "type": ["string", "null"] },
    "shared_post": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "shortcode", "owner_username", "archived_item_pk"],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://www\\.instagram\\.com/(p|reel|tv)/"
            },
            "shortcode": { "type": ["string", "null"] },
            "owner_username": { "type": ["string", "null"] },
            "archived_item_pk": {
              "type": ["string", "null"],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            }
          }
        }
      ]
    },
    "music": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "artist", "start_offset_ms"],
          "properties": {
            "title": { "type": ["string", "null"] },
            "artist": { "type": ["string", "null"] },
            "start_offset_ms": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ]
    },
    "has_image": { "type": "boolean" },
    "has_video": { "type": "boolean" },
    "has_audio": { "type": "boolean" },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "kind", "assets"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["image", "video", "image_with_audio"] },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "filename",
                "mime_type",
                "bytes",
                "sha256"
              ],
              "properties": {
                "type": {
                  "enum": ["image", "video", "audio", "poster", "thumbnail"]
                },
                "filename": { "type": "string", "pattern": "^[0-9]{2}-.+" },
                "mime_type": {
                  "enum": [
                    "image/jpeg",
                    "image/png",
                    "image/webp",
                    "video/mp4",
                    "audio/mp4",
                    "audio/mpeg"
                  ]
                },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "video_codec": { "type": "string" },
                "audio_codec": { "type": "string" },
                "duration_ms": { "type": "integer", "minimum": 1 },
                "bytes": { "type": "integer", "minimum": 1 },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": ["image", "video", "poster", "thumbnail"]
                      }
                    }
                  },
                  "then": {
                    "required": ["width", "height"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
