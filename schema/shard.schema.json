{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenshaorong0118/jaychou-instagram-archive/schema/shard.schema.json",
  "title": "Jay Chou Instagram archive shard index",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "repository",
      "first_published_at",
      "last_published_at",
      "item_count",
      "media_bytes",
      "sealed",
      "sealed_commit"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^media-[0-9]{4}$" },
      "repository": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      },
      "first_published_at": {
        "type": ["string", "null"],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+08:00$"
      },
      "last_published_at": {
        "type": ["string", "null"],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+08:00$"
      },
      "item_count": { "type": "integer", "minimum": 0 },
      "media_bytes": { "type": "integer", "minimum": 0 },
      "sealed": { "type": "boolean" },
      "sealed_commit": {
        "type": ["string", "null"],
        "pattern": "^[a-f0-9]{40}$"
      }
    }
  }
}
