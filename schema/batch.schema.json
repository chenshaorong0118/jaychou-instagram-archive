{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenshaorong0118/jaychou-instagram-archive/schema/batch.schema.json",
  "title": "Instagram public archive batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "client_id",
    "created_at_utc",
    "index_repository",
    "media_repository",
    "branch",
    "items"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "client_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "index_repository": {
      "const": "chenshaorong0118/jaychou-instagram-archive"
    },
    "media_repository": {
      "const": "chenshaorong0118/jaychou-instagram-archive-media-0001"
    },
    "branch": {
      "type": "string",
      "pattern": "^archive-batch/[0-9a-f-]{36}/[0-9a-f-]{36}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "item_type",
        "published_at_utc",
        "published_at_taipei",
        "path",
        "media_count",
        "has_image",
        "has_video",
        "has_audio",
        "metadata",
        "assets"
      ],
      "properties": {
        "pk": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "item_type": { "enum": ["post", "story"] },
        "published_at_utc": { "type": "string", "format": "date-time" },
        "published_at_taipei": { "type": "string", "format": "date-time" },
        "path": {
          "type": "string",
          "pattern": "^(posts|stories)/[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9]{8}T[0-9]{6}\\+0800_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "media_count": { "type": "integer", "minimum": 1 },
        "has_image": { "type": "boolean" },
        "has_video": { "type": "boolean" },
        "has_audio": { "type": "boolean" },
        "metadata": { "$ref": "item.schema.json" },
        "assets": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "payload_path",
        "target_path",
        "mime_type",
        "bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "image",
            "primary_video",
            "playable_video",
            "video_poster",
            "thumbnail",
            "metadata"
          ]
        },
        "payload_path": {
          "type": "string",
          "pattern": "^incoming/[0-9a-f-]{36}/(posts|stories)/"
        },
        "target_path": {
          "type": "string",
          "pattern": "^(posts|stories)/"
        },
        "mime_type": {
          "enum": [
            "application/json",
            "image/jpeg",
            "image/png",
            "image/webp",
            "video/mp4"
          ]
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
